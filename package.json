{
  "name": "automacao-softcomshop",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "e2e": "cypress run --env allure=true",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open  allure-report --host localhost",
    "test:allure": "npm run e2e && npm run report:allure",
    "test:chrome": "cypress run --browser chrome",
    "test:firefox": "cypress run --browser firefox",
    "test:petshop": "cypress run --config-file cypress.config.petshop.js",
    "test:petshop:allure": "cypress run --config-file cypress.config.petshop.js --env allure=true",
    "cypress:open:petshop": "cypress open --config-file cypress.config.petshop.js",
    "test:all": "npm run test:chrome && npm run test:firefox",
    "lint": "eslint . -f table",
    "lint:fix": "eslint . --fix",
    "lint-html": "eslint . -f html -o eslint-report.html",
    "prepare": "husky",
    "ai:rules": "node ai-toolkit/analyze-rules.mjs",
    "ai:scenarios": "node ai-toolkit/generate-scenarios.mjs",
    "ai:flaky": "node ai-toolkit/detect-flaky.mjs",
    "ai:failures": "node ai-toolkit/analyze-failures.mjs",
    "ai:incidents": "node ai-toolkit/analyze-incidents.mjs"
  },
  "lint-staged": {
    "**/*.js": "eslint --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@ai-sdk/openai": "^3.0.28",
    "@faker-js/faker": "^9.0.2",
    "ai": "^6.0.86",
    "allure-commandline": "^2.32.0",
    "cpf-cnpj-validator": "^1.0.3",
    "cypress": "^13.14.2",
    "dotenv": "^17.3.1",
    "faker": "^5.5.3",
    "glob": "^13.0.3",
    "mocha": "^10.7.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cypress/grep": "^4.1.0",
    "@percy/cli": "^1.30.0",
    "@percy/cypress": "^3.1.3-beta.0",
    "@shelex/cypress-allure-plugin": "^2.40.2",
    "allure-cypress": "^3.0.2",
    "cypress-file-upload": "^5.0.8",
    "cypress-wait-until": "^3.0.2",
    "cypress-xpath": "^2.0.1",
    "eslint": "^9.17.0",
    "eslint-formatter-table": "^7.32.1",
    "eslint-friendly-formatter": "^4.0.1",
    "eslint-plugin-cypress": "^4.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3"
  }
}
